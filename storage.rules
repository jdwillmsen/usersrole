rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Each signed-in user gets a private folder and nothing else; the app
    // stores no shared files, so every other path stays closed.
    match /users/{uid}/{allPaths=**} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      // Bounds what one account can add to the bill per object.
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024;
    }
  }
}
